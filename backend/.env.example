PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/resolve-ai
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
NODE_ENV=development
# Optional, required only to create the first administrator in the setup screen.
# Generate a private random value with at least 32 characters; remove it after setup.
ADMIN_SETUP_KEY=
